---
/**
 * Enveloppe commune à toutes les sections de la page d'accueil :
 * même largeur, même rythme vertical, même traitement du titre.
 */
interface Props {
  id: string;
  /** Numéro d'ordre, mis en couleur d'accent. */
  numero: string;
  eyebrow: string;
  titre: string;
  /**
   * Pose un fond distinct, pleine largeur. Les sections alternent : le
   * changement de teinte découpe la page en blocs et remplace avantageusement
   * les filets, qui séparaient sans jamais créer de rythme.
   */
  fond?: boolean;
}

const { id, numero, eyebrow, titre, fond = false } = Astro.props;
---

<section
  id={id}
  class:list={['py-(--spacing-section)', fond && 'bg-raised']}
>
  <div class="mx-auto max-w-(--container-page) px-6 md:px-10">
    <div class="grid gap-10 md:grid-cols-[minmax(0,14rem)_1fr] md:gap-16">
      <div class="md:sticky md:top-28 md:self-start">
        <p class="eyebrow">
          <span class="text-accent">{numero}</span> — {eyebrow}
        </p>
        <h2 class="mt-3 text-heading text-balance">{titre}</h2>
        {/* Filet court : marque le début de section sans peser comme un trait
            pleine largeur. */}
        <span class="mt-4 block h-0.5 w-8 bg-accent" aria-hidden="true"></span>
        {/* Colonne de gauche, sous le titre. Vide par défaut. */}
        <slot name="aside" />
      </div>

      <div>
        <slot />
      </div>
    </div>
  </div>
</section>
