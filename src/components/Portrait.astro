---
import { Image } from 'astro:assets';
import { site } from '../data/site';

/**
 * Portrait de Grégory, affiché dans la colonne de gauche de « À propos ».
 *
 * La photo est détectée automatiquement : déposer un fichier nommé `portrait`
 * dans src/assets/ suffit, aucun code à modifier. Tant qu'il n'y en a pas, un
 * cadre d'instruction s'affiche en développement et rien n'est rendu en
 * production — plutôt qu'un trou silencieux ou un build cassé.
 */
// Les extensions sont listées dans les deux casses : le motif est sensible à
// la casse, et un fichier exporté depuis Windows arrive souvent en .JPG.
const fichiers = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/portrait.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}',
  { eager: true }
);

const portrait = Object.values(fichiers)[0]?.default;
const enDev = import.meta.env.DEV;
---

{
  portrait ? (
    <figure class="mt-8 max-w-56">
      <Image
        src={portrait}
        alt={`Portrait de ${site.nom}`}
        widths={[224, 448]}
        sizes="(min-width: 768px) 14rem, 100vw"
        class="w-full rounded-sm object-cover"
        style="aspect-ratio: 4 / 5"
        loading="lazy"
      />
    </figure>
  ) : enDev ? (
    <div class="mt-8 max-w-56 border border-dashed border-rule bg-raised p-4 text-xs leading-relaxed text-ink-faint" style="aspect-ratio: 4 / 5">
      <p class="font-mono uppercase tracking-widest">Portrait manquant</p>
      <p class="mt-3">
        Déposer une photo dans <code>src/assets/</code> nommée
        <code>portrait.jpg</code> (ou .png / .webp).
      </p>
      <p class="mt-3">
        Cadrage vertical 4/5, visage dans le tiers supérieur. Ce cadre
        n'apparaît qu'en développement.
      </p>
    </div>
  ) : null
}
