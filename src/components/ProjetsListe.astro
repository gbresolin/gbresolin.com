---
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { getProjetsPublies } from '../data/projets';

const projets = await getProjetsPublies();

// Le texte et la numérotation s'ajustent au nombre de projets publiés :
// annoncer « quelques projets » ou numéroter « 01 » devant une entrée unique
// sonnerait faux.
const plusieurs = projets.length > 1;
---

<Section id="projets" numero="04" eyebrow="Projets" titre="Ce que j'ai construit" fond>
  <p class="prose-editorial">
    {plusieurs ? 'Quelques projets détaillés' : 'Un projet détaillé'} plutôt
    qu'un mur de vignettes : le contexte, les contraintes, les décisions
    techniques et ce qu'elles ont coûté.
  </p>

  <ul class="mt-14">
    {
      projets.map((projet, i) => (
        <li class="border-t border-rule last:border-b">
          <a
            href={`/projets/${projet.id}`}
            class="group grid gap-x-6 gap-y-3 py-8 sm:grid-cols-[3rem_1fr_auto] sm:items-baseline"
          >
            <span class="eyebrow tabular-nums">
              {plusieurs ? String(i + 1).padStart(2, '0') : ''}
            </span>

            <div>
              <h3 class="text-title font-display transition-colors group-hover:text-accent">
                {projet.data.titre}
              </h3>
              <p class="mt-2 max-w-(--container-reading) text-ink-soft text-pretty">
                {projet.data.resume}
              </p>
              <p class="mt-3 font-mono text-xs text-ink-faint">
                {projet.data.stack.join(' · ')}
              </p>

              {/* Aperçu recadré sur la partie haute de la capture : l'écran
                  entier serait illisible à cette taille, un bandeau suffit à
                  donner à voir. */}
              {projet.data.apercu && (
                <Image
                  src={projet.data.apercu}
                  alt=""
                  width={880}
                  height={300}
                  fit="cover"
                  position="top"
                  quality={80}
                  loading="lazy"
                  class="mt-6 w-full rounded-sm border border-rule"
                />
              )}
            </div>

            <div class="flex items-center gap-4 text-sm text-ink-faint sm:flex-col sm:items-end sm:gap-1">
              <span class="tabular-nums">{projet.data.annee}</span>
              <span
                class="text-accent transition-transform group-hover:translate-x-1"
                aria-hidden="true"
              >
                →
              </span>
            </div>
          </a>
        </li>
      ))
    }
  </ul>
</Section>
