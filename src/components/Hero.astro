---
import { site } from '../data/site';

const maintenant = new Date().getFullYear();
const annees = maintenant - site.debutCarriere;

/* Trois nombres qui racontent une trajectoire plutôt qu'une affirmation
   d'expérience. Ils se lisent sans rien connaître d'Isi-APP, et ils sont bien
   les siens — les métriques de la plateforme sont l'œuvre d'une équipe et
   n'ont donc pas leur place ici. Calculés, donc jamais périmés. */
const chiffres = [
  { valeur: annees, libelle: 'ans de métier' },
  { valeur: site.societe.depuisProduit - site.debutCarriere, libelle: 'ans à mon compte' },
  {
    valeur: maintenant - site.societe.depuisProduit,
    libelle: 'ans en équipe produit',
  },
];
---

<section
  id="contenu"
  class="mx-auto max-w-(--container-page) px-6 pb-4 pt-10 md:px-10 md:pb-6 md:pt-14"
>
  {/* Une seule ligne quelle que soit la largeur d'écran : la taille est
      pilotée par --ts-display, calibrée pour que le nom tienne sans déborder
      dès 320px. */}
  <h1 class="text-display whitespace-nowrap">{site.prenom} {site.patronyme}</h1>

  {/* Chapô sur toute la largeur, dans une taille relevée par rapport au corps
      de texte pour que la ligne reste lisible malgré la largeur.

      Claude Code n'y figure pas volontairement : le sujet est traité en
      section 02, où il y a la place de l'expliquer. Mentionné ici, il
      installait un avant/après qui invitait à déprécier les années de métier. */}
  <div class="mt-10 border-t border-rule pt-8">
    <p class="text-chapo font-medium text-ink">{site.role}</p>
    <p class="mt-3 text-chapo text-ink-soft text-pretty">
      Je conçois, j'arbitre et je livre des applications métier — de la
      première ligne jusqu'à la mise en production.
    </p>
  </div>

  {/* Chaque entrée est inversée en flex-col-reverse : le chiffre se lit en
      premier, mais reste le <dd> du <dt> qui le nomme. */}
  {/* Largeur bornée : réparties sur toute la page, les trois valeurs se
      dispersent et cessent de se lire comme un ensemble. */}
  <dl
    class="mt-10 grid max-w-2xl grid-cols-3 gap-x-6 gap-y-4 border-t border-rule pt-6"
  >
    {
      chiffres.map((c) => (
        <div class="flex flex-col-reverse">
          <dt class="eyebrow mt-1.5">{c.libelle}</dt>
          <dd class="font-display text-chiffre leading-none text-accent tabular-nums">
            {c.valeur}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
