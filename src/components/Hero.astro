---
import { site } from '../data/site';

const annees = new Date().getFullYear() - site.debutCarriere;
---

<section
  id="contenu"
  class="mx-auto max-w-(--container-page) px-6 pb-12 pt-10 md:px-10 md:pb-16 md:pt-14"
>
  {/* Le nom tient sur une ligne à partir de md et occupe alors toute la
      largeur du conteneur ; en dessous il repasse sur deux lignes. La taille
      est plafonnée pour ne pas déborder une fois le conteneur à sa largeur
      maximale. */}
  <h1 class="text-display md:whitespace-nowrap">
    {site.prenom}<br class="md:hidden" /><span class="hidden md:inline"
      >&nbsp;</span
    >{site.patronyme}
  </h1>

  <div
    class="mt-10 grid gap-8 border-t border-rule pt-8 sm:grid-cols-[1fr_auto] sm:items-end sm:gap-12"
  >
    <p class="max-w-2xl text-lead text-ink-soft text-pretty">
      {/* TODO(contenu) : phrase d'accroche à réécrire avec Grégory. */}
      <strong class="font-medium text-ink">{site.role}</strong> depuis {annees} ans.
      Je conçois des applications métier Laravel, et je les construis
      aujourd'hui avec Claude Code — de la première ligne jusqu'à la mise en
      production.
    </p>

    <dl class="flex gap-10 text-sm sm:justify-end">
      <div>
        <dt class="eyebrow">Aujourd'hui</dt>
        <dd class="mt-1.5">Isi-APP</dd>
      </div>
      <div>
        <dt class="eyebrow">Depuis</dt>
        <dd class="mt-1.5">{site.debutCarriere}</dd>
      </div>
    </dl>
  </div>
</section>
