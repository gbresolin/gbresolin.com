---
import { site } from '../data/site';

const annees = new Date().getFullYear() - site.debutCarriere;
---

<section
  id="contenu"
  class="mx-auto max-w-(--container-page) px-6 pb-(--spacing-section) pt-20 md:px-10 md:pt-32"
>
  <h1 class="text-display text-balance">
    {site.prenom}<br />{site.patronyme}
  </h1>

  <div
    class="mt-12 grid gap-8 border-t border-rule pt-8 md:grid-cols-[1fr_auto] md:items-end md:gap-16"
  >
    <p class="max-w-(--container-reading) text-lead text-ink-soft text-pretty">
      {/* TODO(contenu) : phrase d'accroche à réécrire avec Grégory. */}
      <strong class="font-medium text-ink">{site.role}</strong> depuis {annees} ans.
      Je conçois des applications métier Laravel, et je les construis
      aujourd'hui avec Claude Code — de la première ligne jusqu'à la mise en
      production.
    </p>

    <dl class="flex gap-10 text-sm md:justify-end">
      <div>
        <dt class="eyebrow">Aujourd'hui</dt>
        <dd class="mt-1.5">Isi-APP</dd>
      </div>
      <div>
        <dt class="eyebrow">Depuis</dt>
        <dd class="mt-1.5">{site.debutCarriere}</dd>
      </div>
    </dl>
  </div>
</section>
