# Configuration de déploiement vers o2switch.
#
# Copier ce fichier en .env.deploy et le renseigner.
# .env.deploy n'est jamais versionné : il contient des informations de connexion.

# Hôte SSH. Chez o2switch, un de vos domaines fait l'affaire, ou le nom du
# serveur visible dans le cPanel (par exemple mercure.o2switch.net).
SSH_HOTE=gbresolin.com

# Identifiant cPanel — le même que pour se connecter à l'interface.
SSH_UTILISATEUR=

# Port SSH. 22 chez o2switch.
SSH_PORT=22

# Clé privée utilisée pour la connexion.
SSH_CLE=~/.ssh/id_ed25519_o2switch

# Dossier de préproduction. Doit être un chemin absolu ou relatif au dossier
# de connexion, et surtout PAS le dossier de connexion lui-même : le
# déploiement supprime les fichiers absents du build.
CHEMIN_PREPRODUCTION=public_html/v2

# Dossier de production, une fois la bascule faite.
CHEMIN_PRODUCTION=public_html
